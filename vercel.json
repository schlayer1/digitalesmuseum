{
  "framework": "vite",
  "functions": {
    "api/r2-presign.ts": {
      "maxDuration": 30,
      "memory": 512
    },
    "api/r2-delete.ts": {
      "maxDuration": 30,
      "memory": 512
    },
    "api/r2-file.ts": {
      "maxDuration": 30,
      "memory": 512
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
